[Unit]
Description=luma-sync deploy watcher (runs docker compose rebuilds from the host, outside the container)
After=docker.service
# Wants, not Requires: with Requires, apt upgrading Docker during a
# "System updates" run restarts docker.service, which restarts this unit and
# kills everything in it — apt/dpkg mid-install included — before the
# server restart step is ever reached.
Wants=docker.service

[Service]
Type=simple
ExecStart=/home/hyperlinkhyper/luma-app/server/deploy-watcher.sh
Restart=always
RestartSec=5
User=hyperlinkhyper

[Install]
WantedBy=multi-user.target
