# Who the real client is. Requests reach Caddy through Cloudflare (its
# edge, or the cloudflared tunnel on this machine/LAN), so the TCP peer is a
# Cloudflare edge or a private address shared by every user. From those
# trusted peers Caddy takes the client from CF-Connecting-IP, which
# Cloudflare always overwrites; anyone else connecting directly can't
# choose their own address that way. {client_ip} below is the result.
{
	servers {
		trusted_proxies static private_ranges 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Caddy terminates HTTPS with an automatic Let's Encrypt certificate for
# LUMA_DOMAIN (set in .env) and proxies everything to the sync server.
#
# Uses the Cloudflare DNS-01 challenge (CLOUDFLARE_API_TOKEN in .env,
# needs Zone:DNS:Edit permission on the domain's zone) instead of the
# default HTTP-01/TLS-ALPN-01 challenges. Those need Let's Encrypt to
# reach this machine directly on ports 80/443 — fine for a plain VPS, but
# not when the domain is proxied through Cloudflare (its edge intercepts
# both before they reach the real origin). DNS-01 only needs the API
# token to create a TXT record, no inbound connectivity required, so it
# works the same whether the domain is Cloudflare-proxied or not.
{$LUMA_DOMAIN} {
	tls {
		dns cloudflare {$CLOUDFLARE_API_TOKEN}
	}

	# The admin login is unauthenticated and its forms are a few fields, so Caddy
	# refuses anything bigger before it reaches the app (which caps it too).
	@adminLogin path /admin/login /admin/login/enroll
	request_body @adminLogin {
		max_size 8KB
	}

	# luma-sync reads the client address from here (LUMA_CLIENT_IP_HEADER)
	# for its rate limits, bans and admin lockout. Always overwritten, so a
	# value the client sends never gets through.
	reverse_proxy luma-sync:8080 {
		header_up X-Luma-Client-IP {client_ip}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
