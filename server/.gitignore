# Dart
.dart_tool/

# Compiled server binary (build it locally / in Docker)
luma_server.exe
luma_server

# Runtime data and secrets — never commit these
data/
.env

# Banner render tool dependencies (npm install in tool/)
tool/node_modules/

# A second local data dir some runs have used (LUMA_DATA_DIR=-server-local).
# Same rule as data/: server secrets and account databases, never committed.
/-server-local/
